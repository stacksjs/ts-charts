{
  "name": "ts-charts",
  "type": "module",
  "version": "0.2.1",
  "description": "A complete TypeScript rewrite of D3.js as a Bun-first monorepo.",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-charts.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-charts/issues"
  },
  "keywords": [
    "d3",
    "charts",
    "visualization",
    "typescript",
    "bun"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "test": "TZ=America/Los_Angeles bun test",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "changelog": "bunx --bun logsmith --verbose",
    "changelog:generate": "bunx --bun logsmith --output CHANGELOG.md",
    "release": "bunx --bun bumpx prompt --recursive",
    "dev:docs": "bunx --bun bunpress dev docs",
    "build:docs": "bunx --bun bunpress build docs",
    "preview:docs": "bunx --bun bunpress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "postinstall": "test -n \"$TS_CHARTS_SELF_LINK\" || TS_CHARTS_SELF_LINK=1 bun install --production --no-save || true",
    "release:patch": "bunx --bun bumpx patch --recursive --commit --tag --push --yes"
  },
  "devDependencies": {
    "better-dx": "^0.2.15",
    "bunfig": "^0.15.6",
    "very-happy-dom": "^0.0.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  },
  "exports": {
    ".": "./packages/ts-charts/src/index.ts",
    "./array": "./packages/array/src/index.ts",
    "./axis": "./packages/axis/src/index.ts",
    "./color": "./packages/color/src/index.ts",
    "./ease": "./packages/ease/src/index.ts",
    "./force": "./packages/force/src/index.ts",
    "./format": "./packages/format/src/index.ts",
    "./graph": "./packages/graph/src/index.ts",
    "./interpolate": "./packages/interpolate/src/index.ts",
    "./path": "./packages/path/src/index.ts",
    "./scale": "./packages/scale/src/index.ts",
    "./scale-chromatic": "./packages/scale-chromatic/src/index.ts",
    "./shape": "./packages/shape/src/index.ts",
    "./time": "./packages/time/src/index.ts",
    "./time-format": "./packages/time-format/src/index.ts"
  },
  "overrides": {
    "typescript": "^7.0.2"
  }
}
